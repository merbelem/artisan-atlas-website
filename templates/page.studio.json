      "type": "aa-list",
      "blocks": {
        "pillar_1": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Craft",
            "text": "<p>Celebrating handmade processes and natural materials, and the skill it takes to work them by hand.</p>"
          }
        },
        "pillar_2": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Culture",
            "text": "<p>Connecting traditions and their stories, told with the communities who keep them alive.</p>"
          }
        },
        "pillar_3": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Care",
            "text": "<p>Thoughtful, ethical and enduring choices: in what we make, how it is made, and who it supports.</p>"
          }
        }
      },
