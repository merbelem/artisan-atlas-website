    "values": {
      "type": "aa-list",
      "blocks": {
        "value_1": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Prices agreed openly",
            "text": "<p>Quantities, timelines and pricing are agreed with the makers before any work begins.</p>"
          }
        },
        "value_2": {
          "type": "_aa-list-item",
          "settings": {
            "title": "At the workshop's pace",
            "text": "<p>Production follows the rhythm of the workshop: hand work, drying, firing and the season.</p>"
          }
        },
        "value_3": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Techniques stay with their makers",
            "text": "<p>We design within a tradition, never take it away from the people who hold it.</p>"
          }
        },
        "value_4": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Local, natural materials",
            "text": "<p>Clay dug by hand from the hills above the village. Wool dyed with plants and cochineal.</p>"
          }
        }
      },
