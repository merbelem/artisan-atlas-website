    "working_together": {
      "type": "aa-list",
      "blocks": {
        "step_1": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Conversation",
            "text": "<p>Tell us about your space or your shop, what you need and when.</p>"
          }
        },
        "step_2": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Selection",
            "text": "<p>We match your brief with a workshop whose technique and material fit.</p>"
          }
        },
        "step_3": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Samples",
            "text": "<p>Prototypes are made and refined with the makers before anything is produced.</p>"
          }
        },
        "step_4": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Production",
            "text": "<p>Pieces are made in small batches, at the pace hand work needs.</p>"
          }
        },
        "step_5": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Delivery",
            "text": "<p>Each piece arrives with the story of where and how it was made.</p>"
          }
        }
