    "services": {
      "type": "aa-list",
      "blocks": {
        "service_1": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Wholesale",
            "text": "<p>Small production runs, sold in batches. Tell us about your shop and we will share the lookbook and terms when the first collections are ready. Each piece arrives with the story of where and how it was made.</p>",
            "kicker": "For boutiques and concept stores"
          }
        },
        "service_2": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Hospitality curation",
            "text": "<p>Tableware, textiles and objects chosen for your rooms and tables, produced to the makers' capacity. We plan quantities and timing with you and the workshop from the start.</p>",
            "kicker": "For hotels, restaurants and spas"
          }
        },
        "service_3": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Bespoke collaborations",
            "text": "<p>Custom collections developed with one or more artisan groups, from first sample to finished piece. Forms, colours and sizes are designed within each workshop's technique.</p>",
            "kicker": "For brands and studios"
          }
        },
        "service_4": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Project sourcing",
            "text": "<p>Sizes, colours and quantities for residential and commercial projects, made within each workshop's technique. We tell you honestly what is possible, and how long it will take.</p>",
            "kicker": "For interior designers and architects"
          }
        }
      },
      "block_order": [
        "service_1",
        "service_2",
        "service_3",
        "service_4"
      ],
