        "padding-block-end": 96
      }
    },
    "clay": {
      "type": "aa-text-media",
      "settings": {
        "eyebrow": "San Marcos Tlapazola · Red clay",
        "heading": "Clay from the hills above the village",
        "heading_size": "h2",
        "body": "<p>A women's pottery collective shapes every piece entirely by hand. The red clay is dug by hand from the hills above the village, mixed with river sand for strength, and kneaded to draw out the air.</p><p>There is no glaze and no paint. Pieces are burnished with river stones and finished with thin layers of red clay, dried in the shade, then fired in the open air, where the smoke leaves marks no two pieces share.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "button-secondary",
        "image": "",
        "shape": "stack",
        "image_side": "left",
        "media_width": "medium",
        "caption": "Red clay, shaped by hand",
        "place": "San Marcos Tlapazola",
        "motif": "none",
        "motif_position": "top-left",
        "color_scheme": "scheme-1",
        "wave_top": "none",
        "anchor_id": "red-clay",
        "padding-block-start": 96,
        "padding-block-end": 96
      }
    },
    "clay_process": {
      "type": "aa-list",
      "blocks": {
        "step_1": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Dig",
            "text": "<p>Clay is dug by hand from the hills above the village.</p>"
          }
        },
        "step_2": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Prepare",
            "text": "<p>It is soaked, mixed with river sand, and kneaded by hand to remove the air.</p>"
          }
        },
        "step_3": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Shape",
            "text": "<p>Each piece is shaped by hand, with corn cobs, leather and wooden tools.</p>"
          }
        },
        "step_4": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Burnish",
            "text": "<p>Thin layers of red clay are polished with river stones, in place of a glaze.</p>"
          }
        },
        "step_5": {
          "type": "_aa-list-item",
          "settings": {
            "title": "Fire",
            "text": "<p>Pieces are fired in the open air; the smoke leaves its own marks.</p>"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4",
        "step_5"
      ],
