    "intro": {
      "type": "aa-text-media",
      "settings": {
        "eyebrow": "Where we begin",
        "heading": "Two workshops, one in red clay and one in wool",
        "heading_size": "h2",
        "body": "<p>In the valleys and hills of Oaxaca, craft is part of daily life: towns that have shaped clay for generations, and weaving communities that keep Zapotec textile traditions alive.</p><p>This is where Artisan Atlas begins.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "button-secondary",
        "image": "",
        "shape": "arch",
        "image_side": "right",
        "media_width": "medium",
        "caption": "",
        "place": "",
