<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'fonts-custom' -%}
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <style>
      :root {
        {% if settings.enable_custom_fonts %}
          {%- case settings.custom_heading_font -%}
            {%- when 'spitzkant' -%}
              --custom-heading-font-family: "Spitzkant", serif;
            {%- else -%}
              --custom-heading-font-family: var(--font-heading-family);
          {%- endcase -%}

          {%- case settings.custom_body_font -%}
            {%- when 'spitzkant' -%}
              --custom-body-font-family: "Spitzkant", serif;
            {%- else -%}
              --custom-body-font-family: var(--font-body-family);
          {%- endcase -%}

          {%- case settings.custom_accent_font -%}
            {%- when 'spitzkant' -%}
              --custom-accent-font-family: "Spitzkant", serif;
            {%- else -%}
              --custom-accent-font-family: var(--font-body-family);
          {%- endcase -%}
          --button-font-family-primary: var(--custom-accent-font-family);
          --button-font-family-secondary: var(--custom-accent-font-family);
        {% else %}
          --custom-heading-font-family: var(--font-heading-family);
          --custom-body-font-family: var(--font-body-family);
          --custom-accent-font-family: var(--font-body-family);
          --button-font-family-primary: var(--font-body-family);
          --button-font-family-secondary: var(--font-body-family);
        {% endif %}
      }
    </style>
    <style>
      /* Fade the header without moving it vertically. Fade in relatively quickly, but fade out slowly. */
      #header-group > .header-section {
        transition-property: opacity;
        transition-duration: 350ms;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity;
      }

      #header-group.aa-header-hidden > .header-section {
        opacity: 0;
        pointer-events: none;
        transition-duration: 1200ms;
      }

      @media (prefers-reduced-motion: reduce) {
        #header-group > .header-section {
          transition: none;
        }
      }
    </style>

  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      (() => {
        const header = document.getElementById('header-group');

        if (!header) return;

        const topThreshold = 2;
        const idleDelay = 600;
        let hideTimer;

        const showHeader = () => {
          window.clearTimeout(hideTimer);
          header.classList.remove('aa-header-hidden');
        };

        const hideAfterIdle = () => {
          window.clearTimeout(hideTimer);

          if (
            window.scrollY <= topThreshold ||
            header.contains(document.activeElement)
          ) {
            showHeader();
            return;
          }

          hideTimer = window.setTimeout(() => {
            if (
              window.scrollY > topThreshold &&
              !header.contains(document.activeElement)
            ) {
              header.classList.add('aa-header-hidden');
            }
          }, idleDelay);
        };

        const handleScroll = () => {
          showHeader();
          hideAfterIdle();
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        header.addEventListener('focusin', showHeader);
        header.addEventListener('focusout', hideAfterIdle);

        if (window.scrollY > topThreshold) {
          hideAfterIdle();
        }
      })();
    </script>


    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
