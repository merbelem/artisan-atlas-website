{%- assign s = section.settings -%}

{% capture children %}
  {% render 'aa-section-header', settings: s, alignment: s.header_alignment %}

  <ol
    class="aa-list aa-list--{{ s.layout }} list-unstyled{% if s.numbered %} aa-list--numbered{% endif %}"
    style="--aa-list-columns: {{ s.columns }};"
    role="list"
  >
    {% content_for 'blocks' %}
  </ol>
{% endcapture %}

{% render 'aa-section', section: section, children: children, class: 'aa-list-section' %}

{% stylesheet %}
  .aa-list {
    display: grid;
    gap: var(--aa-space-2xl) clamp(1.5rem, 4vw, 4rem);
    margin: var(--aa-space-2xl) 0 0;
    padding: 0;
    counter-reset: aa-list;
  }

  .aa-list__item {
    counter-increment: aa-list;
  }

  .aa-list--numbered .aa-list__item::before {
    content: counter(aa-list, decimal-leading-zero);
    display: block;
    margin-bottom: var(--aa-space-md);
    font-family: var(--aa-font-display);
    font-size: var(--aa-step-3);
    line-height: 1;
    color: var(--color-primary);
  }

  .aa-list__kicker {
    margin: 0 0 var(--aa-space-xs);
    font-size: var(--aa-step--2);
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / .75);
  }

  .aa-list__title {
    margin: 0;
    font-size: var(--aa-step-2);
    text-wrap: balance;
  }

  .aa-list__text {
    margin-top: var(--aa-space-sm);
  }

  .aa-list__link {
    display: inline-block;
    margin-top: var(--aa-space-md);
  }

  /* Columns: items in a grid, with a fine rule above each. */
  .aa-list--columns .aa-list__item {
    padding-top: var(--aa-space-lg);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / .2);
  }

  /* Steps: a sequence joined by a line on wide screens. */
  .aa-list--steps .aa-list__item {
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .aa-list--columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .aa-list--steps {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .aa-list--steps.aa-list--numbered .aa-list__item::after {
      content: '';
      position: absolute;
      top: calc(var(--aa-step-3) / 2);
      left: calc(2.5ch + var(--aa-space-md));
      right: calc(clamp(1.5rem, 4vw, 4rem) * -1 + var(--aa-space-md));
      border-top: 1px solid rgb(var(--color-foreground-rgb) / .25);
    }

    .aa-list--steps .aa-list__item:last-child::after {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .aa-list--columns {
      grid-template-columns: repeat(var(--aa-list-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

