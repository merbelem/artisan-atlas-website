{%- assign s = section.settings -%}

{% capture children %}
  <div class="aa-contact">
    <div class="aa-contact__text">
      {%- liquid
        assign heading_class = ''
        if s.heading_level == 'h1'
          assign heading_class = 'h2'
        endif
      -%}
      {% render 'aa-section-header', settings: s, heading_tag: s.heading_level, heading_class: heading_class %}
      {%- if s.email != blank or s.instagram_url != blank -%}
        <div class="aa-contact__direct">
          {%- if s.details_heading != blank -%}
            <p class="aa-contact__direct-heading">{{ s.details_heading }}</p>
          {%- endif -%}
          <ul class="aa-contact__details list-unstyled" role="list">
            {%- if s.email != blank -%}
              <li>
                <span class="aa-contact__label">{{ 'aa.contact.email_label' | t }}</span>
                <a class="aa-link" href="mailto:{{ s.email }}">{{ s.email }}</a>
              </li>
            {%- endif -%}
            {%- if s.instagram_url != blank -%}
              <li>
                <span class="aa-contact__label">{{ 'aa.contact.instagram_label' | t }}</span>
                <a class="aa-link" href="{{ s.instagram_url }}" target="_blank" rel="noopener">{{ s.instagram_label | default: 'Instagram' }}</a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
    <div class="aa-contact__form">
      {% content_for 'blocks' %}
    </div>
  </div>
{% endcapture %}

{% render 'aa-section', section: section, children: children, class: 'aa-contact-section' %}

{% stylesheet %}
  .aa-contact {
    display: grid;
    gap: var(--aa-space-2xl) clamp(2rem, 6vw, 6rem);
  }

  .aa-contact__direct {
    margin-top: var(--aa-space-2xl);
  }

  .aa-contact__direct-heading {
    margin: 0 0 var(--aa-space-md);
    font-family: var(--aa-font-display);
    font-size: var(--aa-step-1);
  }

  .aa-contact__details {
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--aa-space-md);
  }

  .aa-contact__label {
    display: block;
    margin-bottom: var(--aa-space-2xs);
    font-size: var(--aa-step--2);
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / .7);
  }

  @media screen and (min-width: 990px) {
    .aa-contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "blocks": [
    {
      "type": "contact-form"
    }
  ],
  "max_blocks": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start a conversation"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        {
          "value": "h2",
          "label": "Section heading (H2)"
        },
        {
          "value": "h1",
          "label": "Page heading (H1)"
        }
      ],
      "default": "h2",
      "info": "Use Page heading when this is the main heading of the page. Each page should have one."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Details"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Heading above contact details",
      "default": "Or write to us directly"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "connect@theartisanatlas.com"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram label",
      "default": "@the.artisanatlas"
    },
    {
      "type": "header",
      "content": "Motif"
    },
    {
      "type": "select",
      "id": "motif",
      "label": "Motif",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "floral-8",
          "label": "Flower"
        },
        {
          "value": "floral-thin-8",
          "label": "Fine flower"
        },
        {
          "value": "floral-4",
          "label": "Leaf fan"
        },
        {
          "value": "reef",
          "label": "Reef"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ],
      "default": "none",
      "info": "A faint brand shape behind the content."
    },
    {
      "type": "select",
      "id": "motif_position",
      "label": "Motif position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "behind",
          "label": "Centred behind"
        }
      ],
      "default": "bottom-left",
      "visible_if": "{{ section.settings.motif != 'none' }}"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-6569cff2-6bc6-4188-a473-bae0a44e6ac5"
    },
    {
      "type": "select",
      "id": "wave_top",
      "label": "Wavy top edge",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "straight",
          "label": "Wave"
        },
        {
          "value": "soft",
          "label": "Soft wave"
        }
      ],
      "default": "straight",
      "info": "Curves this section's background up into the Sand page colour above it."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For in-page links, e.g. work-with-us"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "category": "Artisan Atlas",
      "settings": {
        "intro": "<p>Tell us about your shop or your space, and what you are looking for. We reply personally.</p>",
        "anchor_id": "contact-us"
      },
      "blocks": {
        "form": {
          "type": "contact-form",
          "settings": {
            "show_trade_fields": true,
            "width": "custom",
            "custom_width": 100,
            "width_mobile": "custom",
            "custom_width_mobile": 100
          }
        }
      },
      "block_order": [
        "form"
      ]
    }
  ],
  "class": "section-wrapper"
}
{% endschema %}
