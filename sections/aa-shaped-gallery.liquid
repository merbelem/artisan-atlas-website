{%- liquid
  assign s = section.settings
  assign label = s.heading | default: s.eyebrow | default: 'Gallery'
-%}

{% capture children %}
  {% render 'aa-section-header', settings: s, alignment: s.header_alignment %}

  <ul
    class="aa-scroller list-unstyled"
    role="list"
    tabindex="0"
    aria-label="{{ 'aa.gallery.scroll_label' | t: title: label | escape }}"
  >
    {% content_for 'blocks' %}
  </ul>
{% endcapture %}

{% render 'aa-section', section: section, children: children, class: 'aa-shaped-gallery' %}

{% stylesheet %}
  .aa-shaped-gallery .aa-scroller__item {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shaped gallery",
  "blocks": [
    {
      "type": "_aa-shaped-image"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Oaxaca"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "start",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Motif"
    },
    {
      "type": "select",
      "id": "motif",
      "label": "Motif",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "floral-8",
          "label": "Flower"
        },
        {
          "value": "floral-thin-8",
          "label": "Fine flower"
        },
        {
          "value": "floral-4",
          "label": "Leaf fan"
        },
        {
          "value": "reef",
          "label": "Reef"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ],
      "default": "floral-8",
      "info": "A faint brand shape behind the content."
    },
    {
      "type": "select",
      "id": "motif_position",
      "label": "Motif position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "behind",
          "label": "Centred behind"
        }
      ],
      "default": "top-left",
      "visible_if": "{{ section.settings.motif != 'none' }}"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "wave_top",
      "label": "Wavy top edge",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "straight",
          "label": "Wave"
        },
        {
          "value": "soft",
          "label": "Soft wave"
        }
      ],
      "default": "none",
      "info": "Curves this section's background up into the Sand page colour above it."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For in-page links, e.g. work-with-us"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Shaped gallery",
      "category": "Artisan Atlas",
      "blocks": {
        "image_1": {
          "type": "_aa-shaped-image",
          "settings": {
            "shape": "stack",
            "caption": "Caption"
          }
        },
        "image_2": {
          "type": "_aa-shaped-image",
          "settings": {
            "shape": "arch",
            "caption": "Caption"
          }
        },
        "image_3": {
          "type": "_aa-shaped-image",
          "settings": {
            "shape": "vase-wide",
            "caption": "Caption"
          }
        },
        "image_4": {
          "type": "_aa-shaped-image",
          "settings": {
            "shape": "circle",
            "caption": "Caption"
          }
        }
      },
      "block_order": [
        "image_1",
        "image_2",
        "image_3",
        "image_4"
      ]
    }
  ],
  "class": "section-wrapper"
}
{% endschema %}
