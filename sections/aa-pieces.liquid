{%- liquid
  assign s = section.settings
  assign label = s.heading | default: s.eyebrow | default: 'Pieces'
-%}

{% capture children %}
  {% render 'aa-section-header', settings: s, alignment: s.header_alignment %}

  <ul
    class="aa-scroller aa-pieces list-unstyled"
    role="list"
    tabindex="0"
    aria-label="{{ 'aa.gallery.scroll_label' | t: title: label | escape }}"
  >
    {%- if s.collection != blank and s.collection.products_count > 0 -%}
      {%- for product in s.collection.products limit: s.products_to_show -%}
        <li class="aa-scroller__item">
          {% render 'aa-piece-card', product: product, default_status: s.default_status %}
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <li class="aa-scroller__item">
          {% render 'aa-piece-card', index: i, default_status: s.default_status %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
{% endcapture %}

{% render 'aa-section', section: section, children: children, class: 'aa-pieces-section' %}

{% stylesheet %}
  .aa-pieces {
    --aa-scroller-item: clamp(230px, 27vw, 340px);
  }

  .aa-piece-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .aa-piece-card__status {
    display: inline-block;
    margin: 0 0 var(--aa-space-md);
    padding: .3em .9em;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / .06);
    font-size: var(--aa-step--2);
    letter-spacing: .06em;
  }

  .aa-piece-card__media {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
  }

  /* Cut-outs on white backgrounds blend into the page colour. */
  .aa-piece-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform .6s var(--aa-ease);
  }

  .aa-piece-card__placeholder {
    display: block;
    height: 70%;
    aspect-ratio: var(--aa-shape-ratio);
    background: rgb(var(--color-foreground-rgb) / .12);
    -webkit-mask: var(--aa-mask) center / contain no-repeat;
    mask: var(--aa-mask) center / contain no-repeat;
  }

  .aa-piece-card__link:hover .aa-piece-card__img {
    transform: translateY(-6px);
  }

  .aa-piece-card__maker,
  .aa-piece-card__material {
    margin: var(--aa-space-sm) 0 0;
    font-size: var(--aa-step--1);
    color: rgb(var(--color-foreground-rgb) / .78);
  }

  .aa-piece-card__title {
    margin: var(--aa-space-xs) 0 0;
    font-size: var(--aa-step-1);
  }

  @media (prefers-reduced-motion: reduce) {
    .aa-piece-card__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pieces",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Colección Tierra"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pieces in development"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Pieces to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "default_status",
      "label": "Label",
      "options": [
        {
          "value": "in_development",
          "label": "In development"
        },
        {
          "value": "in_design",
          "label": "In design"
        },
        {
          "value": "available",
          "label": "Available to trade"
        }
      ],
      "default": "in_development",
      "info": "Used when a piece has no custom.status metafield."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "wave_top",
      "label": "Wavy top edge",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "straight",
          "label": "Wave"
        },
        {
          "value": "soft",
          "label": "Soft wave"
        }
      ],
      "default": "none",
      "info": "Curves this section's background up into the Sand page colour above it."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For in-page links, e.g. work-with-us"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Pieces",
      "category": "Artisan Atlas"
    }
  ],
  "class": "section-wrapper"
}
{% endschema %}
