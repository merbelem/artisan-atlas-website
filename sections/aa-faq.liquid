{%- assign s = section.settings -%}

{% capture children %}
  <div class="aa-faq">
    {% render 'aa-section-header', settings: s %}
    <div class="aa-faq__items">
      {% content_for 'blocks' %}
    </div>
  </div>
{% endcapture %}

{% render 'aa-section', section: section, children: children, class: 'aa-faq-section' %}

{% stylesheet %}
  .aa-faq {
    display: grid;
    gap: var(--aa-space-2xl) clamp(2rem, 6vw, 6rem);
  }

  .aa-faq__item {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / .2);
  }

  .aa-faq__item:last-child {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / .2);
  }

  .aa-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--aa-space-lg);
    padding: var(--aa-space-lg) 0;
    font-family: var(--aa-font-display);
    font-size: var(--aa-step-1);
    cursor: pointer;
    list-style: none;
  }

  .aa-faq__question::-webkit-details-marker {
    display: none;
  }

  .aa-faq__question::after {
    content: '+';
    font-family: var(--aa-font-body);
    font-weight: 300;
    transition: transform .3s var(--aa-ease);
  }

  .aa-faq__item[open] .aa-faq__question::after {
    transform: rotate(45deg);
  }

  .aa-faq__answer {
    padding-bottom: var(--aa-space-lg);
  }

  @media screen and (min-width: 990px) {
    .aa-faq {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Questions",
  "blocks": [
    {
      "type": "_aa-faq-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Practicalities"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "wave_top",
      "label": "Wavy top edge",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "straight",
          "label": "Wave"
        },
        {
          "value": "soft",
          "label": "Soft wave"
        }
      ],
      "default": "none",
      "info": "Curves this section's background up into the Sand page colour above it."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For in-page links, e.g. work-with-us"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Questions",
      "category": "Artisan Atlas",
      "blocks": {
        "faq_1": {
          "type": "_aa-faq-item",
          "settings": {
            "question": "Is there a minimum order?",
            "answer": "<p>Minimums depend on the piece and the workshop. We'll suggest a quantity that works for you and for the makers.</p>"
          }
        },
        "faq_2": {
          "type": "_aa-faq-item",
          "settings": {
            "question": "How long does production take?",
            "answer": "<p>Handmade pieces take time. We agree a realistic timeline with the makers before you commit, and keep you updated as the work progresses.</p>"
          }
        },
        "faq_3": {
          "type": "_aa-faq-item",
          "settings": {
            "question": "Can pieces be made to our specifications?",
            "answer": "<p>Often, yes: sizes, colours and quantities can be adapted within each workshop's technique. We'll tell you honestly what's possible.</p>"
          }
        },
        "faq_4": {
          "type": "_aa-faq-item",
          "settings": {
            "question": "Where do you deliver?",
            "answer": "<p>Tell us where your space is and we'll quote delivery with the order.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4"
      ]
    }
  ],
  "class": "section-wrapper"
}
{% endschema %}
