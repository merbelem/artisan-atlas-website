{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  if s.heading_size == 'h1'
    assign heading_tag = 'h1'
  endif
-%}

{% capture children %}
  <div class="aa-text-media aa-text-media--image-{{ s.image_side }} aa-text-media--media-{{ s.media_width }}">
    <div class="aa-text-media__text">
      {%- if s.eyebrow != blank -%}
        <p class="aa-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <{{ heading_tag }} class="aa-text-media__heading {{ s.heading_size }}">{{ s.heading }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="aa-prose aa-prose--narrow rte">{{ s.body }}</div>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a class="aa-text-media__action {{ s.button_style }}" href="{{ s.button_link }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="aa-text-media__media">
      {% render 'aa-shaped-image',
        image: s.image,
        shape: s.shape,
        caption: s.caption,
        place: s.place,
        sizes: '(min-width: 750px) 40vw, 80vw'
      %}
    </div>
  </div>
{% endcapture %}

{% render 'aa-section', section: section, children: children %}

{% stylesheet %}
  .aa-text-media {
    --aa-media-column: 1fr;

    display: grid;
    gap: var(--aa-space-2xl) clamp(2rem, 7vw, 7rem);
    align-items: center;
  }

  .aa-text-media--media-small { --aa-media-column: 0.7fr; }
  .aa-text-media--media-large { --aa-media-column: 1.3fr; }

  .aa-text-media__text > * + * {
    margin-top: var(--aa-space-lg);
  }

  .aa-text-media__heading {
    margin: 0;
    text-wrap: balance;
  }

  .aa-text-media__action {
    display: inline-flex;
    margin-top: var(--aa-space-xl);
  }

  .aa-text-media__media {
    justify-self: center;
    width: min(100%, 420px);
  }

  .aa-text-media--media-large .aa-text-media__media {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .aa-text-media {
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--aa-media-column));
    }

    .aa-text-media--image-left .aa-text-media__media {
      order: -1;
    }

    .aa-text-media--image-left {
      grid-template-columns: minmax(0, var(--aa-media-column)) minmax(0, 1fr);
    }
  }
{% endstylesheet %}

