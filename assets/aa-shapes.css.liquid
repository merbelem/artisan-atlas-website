/* ===========================
   Artisan Atlas – Shapes
   Image masks, decorative motifs and wave edges (brand guidelines p.9).
   =========================== */

/* Circular media — pairs well with the image block's square ratio.
   Interim: replaced by .aa-mask--circle once the shape system lands. */
.aa-image-circle img,
.aa-image-circle .placeholder-image {
  clip-path: var(--shape--circle);
  aspect-ratio: 1;
}

/* Contact section wave
   The curve begins inside Contact: cream shows through above it, while the
   beige fill continues from the bottom of the SVG through the whole section. */

.section-wrapper:has(> #artisans) > .section-background {
  background: var(--sand);
}

.section-wrapper:has(> .aa-contact-wave) {
  --aa-contact-wave-height: clamp(400px, 38vw, 520px);
  --aa-contact-wave-overlap: 0px;
  --aa-contact-wave-depth: var(--aa-contact-wave-height);
  --aa-contact-content-offset: clamp(48px, 5vw, 72px);

  background: var(--sand);
}

.section-wrapper:has(> .aa-contact-wave) > .section-background {
  top: calc(var(--aa-contact-wave-depth) - 1px);
  bottom: 0;
  z-index: var(--layer-base);
  background: var(--linen);
}

.aa-contact-wave {
  z-index: calc(var(--layer-base) + 1);
}

.aa-contact-wave::before {
  content: '';
  position: absolute;
  top: calc(var(--aa-contact-wave-overlap) * -1);
  right: 0;
  left: 0;
  height: var(--aa-contact-wave-height);
  z-index: var(--layer-base);
  background: var(--linen);
  pointer-events: none;

  -webkit-mask: url('{{ "edge-wave-rect-straight.svg" | asset_url }}') center / 100% 100% no-repeat;
  mask: url('{{ "edge-wave-rect-straight.svg" | asset_url }}') center / 100% 100% no-repeat;
  transform: scaleY(-1);
}

.aa-contact-wave .section-content-wrapper {
  padding-block-start: calc(var(--padding-block-start) + var(--aa-contact-content-offset));
}

@media screen and (max-width: 749px) {
  .section-wrapper:has(> .aa-contact-wave) {
    --aa-contact-wave-height: clamp(220px, 58vw, 300px);
    --aa-contact-content-offset: clamp(32px, 10vw, 48px);
  }
}

/* Reusable wavy top-edge divider — toggle on any `sections/section.liquid`
   instance via its "Wavy top edge" setting. Unlike the Contact-specific wave
   above, this one picks up the section's own color scheme (--color-background)
   instead of hardcoding sand/linen, so it works with whatever scheme a
   section is assigned. */
.section-wrapper:has(> .aa-wave-divider-top) {
  --aa-wave-height: clamp(400px, 38vw, 520px);
  --aa-wave-content-offset: clamp(48px, 5vw, 72px);

  background: var(--aa-wave-bg-above, var(--sand));
}

.aa-wave-divider-top {
  z-index: calc(var(--layer-base) + 1);
}

.aa-wave-divider-top::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: var(--aa-wave-height);
  z-index: var(--layer-base);
  background: rgb(var(--color-background-rgb));
  pointer-events: none;

  -webkit-mask: url('{{ "edge-wave-rect-straight.svg" | asset_url }}') center / 100% 100% no-repeat;
  mask: url('{{ "edge-wave-rect-straight.svg" | asset_url }}') center / 100% 100% no-repeat;
  transform: scaleY(-1);
}

.aa-wave-divider-top .section-content-wrapper {
  padding-block-start: calc(var(--padding-block-start) + var(--aa-wave-content-offset));
}

@media screen and (max-width: 749px) {
  .section-wrapper:has(> .aa-wave-divider-top) {
    --aa-wave-height: clamp(220px, 58vw, 300px);
    --aa-wave-content-offset: clamp(32px, 10vw, 48px);
  }
}

/* Hero wavy bottom edge — toggle via the Hero section's "Wavy bottom edge"
   setting. Masks a band of the hero's own color-scheme background over the
   bottom of the media (image/video), so the wave reads as a frame around
   the media rather than a hard rectangular crop. */
.hero__container--wave-bottom::before,
.hero__container--wave-bottom::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  aspect-ratio: 4096 / 559;
  transform-origin: bottom;
  transform: translateY(3%) scaleY(0.8);
  z-index: calc(var(--layer-flat) + 1);
  background: rgb(var(--color-background-rgb));
  pointer-events: none;

  -webkit-mask: url('{{ "hero-wave-bottom-01.svg" | asset_url }}') center / 100% 100% no-repeat;
  mask: url('{{ "hero-wave-bottom-01.svg" | asset_url }}') center / 100% 100% no-repeat;
}
